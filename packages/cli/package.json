{
  "name": "@agentic-tools/cli",
  "version": "0.0.0",
  "description": "Agentic Tools CLI: config validation, tool listing with token footprint, platform diagnostics, MCP server launch (FR-016, FR-018).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "agentic-tools": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@agentic-tools/adapter-mcp": "workspace:*",
    "@agentic-tools/core": "workspace:*",
    "@agentic-tools/runtime": "workspace:*",
    "@agentic-tools/security": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
