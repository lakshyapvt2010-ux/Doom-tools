{
  "name": "@agentic-tools/adapter-mcp",
  "version": "0.0.0",
  "description": "MCP server adapter for Agentic Tools (stdio transport). Primary exposure surface (PRD 10).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
