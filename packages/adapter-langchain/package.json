{
  "name": "@agentic-tools/adapter-langchain",
  "version": "0.0.0",
  "description": "LangChain/LangGraph adapter for Agentic Tools. Thin translation only; the runtime owns policy (PRD 10).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@agentic-tools/core": "workspace:*",
    "@agentic-tools/runtime": "workspace:*"
  },
  "peerDependencies": {
    "@langchain/core": "~1.5.0"
  },
  "devDependencies": {
    "@langchain/core": "1.5.0",
    "@langchain/langgraph": "1.7.5",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
