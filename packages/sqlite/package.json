{
  "name": "@agentic-tools/sqlite",
  "version": "0.0.0",
  "description": "Read-only SQLite query tool for Agentic Tools (PRD P1: SQLite read). Uses node:sqlite.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@agentic-tools/core": "workspace:*",
    "@agentic-tools/filesystem": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "@agentic-tools/runtime": "workspace:*",
    "@agentic-tools/security": "workspace:*"
  }
}
